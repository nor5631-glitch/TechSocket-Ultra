                    { name: "GIGABYTE", models: ["B450 AORUS Elite", "B550M AORUS PRO-P", "X570 AORUS Master", "GA-A320M-S2H", "B450M DS3H", "X470 AORUS Gaming 7", "B550 AORUS ELITE AX", "AB350M-Gaming 3", "X570 I AORUS PRO WIFI", "A520M DS3H"] },
                    { name: "COLORFUL", models: ["CVN B550M GAMING FROZEN V14", "Battle-AX B450M-G", "CVN X570M GAMING PRO", "Battle-AX A320M-M.2", "CVN B450M GAMING V14"] }
                ]
            },
            "AM5": {
                name: "AMD Socket AM5 (Socket LGA 1718)",
                era: "AMD Era Terkini Komitmen Jangka Panjang (Hayat Platform sehingga 2029+)",
                desc: "Soket desktop format reka bentuk grid daratan (LGA) pertama bagi AMD kategori pengguna arus perdana, direka eksklusif untuk kestabilan memori DDR5 penuh.",
                chipsets: "A620, B650, X670, X870, X870E, B650E, X670E",
                ram: "DDR5 Sahaja",
                cpuSupport: "AMD Ryzen 7 7800X3D, Ryzen 7 9800X3D, Ryzen 7 9850X3D, Ryzen 9 9950X3D.",
                brands: [
                    { name: "ASUS", models: ["ROG Crosshair X670E Hero", "ROG Strix B650-A Gaming WiFi", "TUF Gaming X670E-Plus WiFi", "ProArt X870E-CREATOR WIFI", "PRIME B650M-A", "ROG Strix X870-E Gaming WiFi", "TUF Gaming B650-PLUS WIFI", "PRIME A620M-K", "ROG Strix B650E-E GAMING WIFI", "TUF Gaming X870-Plus WiFi"] },
                    { name: "MSI", models: ["MAG B650 TOMAHAWK WIFI", "PRO B650M-A WIFI", "MPG X870E CARBON WIFI", "MEG X870E GODLIKE", "MAG X670E TOMAHAWK WIFI", "B650M GAMING PLUS WIFI", "MPG B650 EDGE WIFI", "PRO A620M-E", "MPG X670E CARBON WIFI"] },
                    { name: "GIGABYTE", models: ["X870 AORUS ELITE WIFI7", "X670E AORUS MASTER", "B650 AORUS ELITE AX", "B650M GAMING X AX", "A620M GAMING X", "X870E AORUS MASTER", "B650E AORUS TACHYON", "B650M DS3H", "X670 AORUS ELITE AX"] },
                    { name: "ASROCK", models: ["X870E Taichi", "B650M Steel Legend WiFi", "X670E Pro RS", "A620M Pro RS WiFi", "B650 Pro RS", "X870 Pro RS", "B650M-HDV/M.2", "X670E Taichi Carrara", "B650E Steel Legend"] }
                ]
            }
        };

        // Fungsi Mengesan Butang Enter Pada Papan Kekunci
        function checkEnter(event) {
            if (event.key === 'Enter') {
                performSearch();
            }
        }

        // Fungsi Membersihkan Input
        function clearSearch() {
            document.getElementById('searchInput').value = "";
            document.getElementById('notificationBox').classList.add('hidden');
            document.getElementById('resultsSection').classList.add('hidden');
            document.getElementById('emptyState').classList.remove('hidden');
        }

        // Fungsi Pengendali Utama Enjin Carian Pintar Hibrid (Soket / Brand / Model)
        function performSearch() {
            const queryRaw = document.getElementById('searchInput').value;
            const query = queryRaw.trim().toUpperCase();
            
            const notificationBox = document.getElementById('notificationBox');
            const resultsSection = document.getElementById('resultsSection');
            const emptyState = document.getElementById('emptyState');
            const dynamicResultsContainer = document.getElementById('dynamicResultsContainer');

            // Set semula paparan asal
            notificationBox.classList.add('hidden');
            dynamicResultsContainer.innerHTML = "";

            if (!query) {
                showNotification("Sila taip kata kunci carian (cth: ASUS, Tomahawk, 1155, AM4).");
                resultsSection.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }

            let matchedKeys = [];
            let filterSpecificBrand = null;
            let searchMethodUsed = "Carian Bersepadu Perkakasan";

            // Senarai nama pengeluar/jenama utama untuk semakan pintar
            const knownBrands = ["ASUS", "MSI", "GIGABYTE", "ASROCK", "COLORFUL", "EVGA", "INTEL"];
            const isBrandQuery = knownBrands.includes(query);

            if (isBrandQuery) {
                filterSpecificBrand = query;
                searchMethodUsed = `Tapis Mengikut Pengeluar Penuh (${query})`;
                // Masukkan semua jenis soket yang mengandungi jenama ini
                for (let key in socketDatabase) {
                    if (socketDatabase[key].brands.some(b => b.name.toUpperCase() === query)) {
                        matchedKeys.push(key);
                    }
                }
            } else if (socketDatabase[query]) {
                // Padanan kunci soket tepat
                matchedKeys.push(query);
                searchMethodUsed = "Padanan Kod Soket Tepat";
            } else {
                // Imbas teks dalam pangkalan data untuk chipset, nama soket, atau nama model spesifik
                for (let key in socketDatabase) {
                    const data = socketDatabase[key];
                    let isSocketOrChipsetMatch = key.toUpperCase().includes(query) || 
                                                 data.name.toUpperCase().includes(query) || 
                                                 data.chipsets.toUpperCase().includes(query);
                    
                    if (isSocketOrChipsetMatch) {
                        matchedKeys.push(key);
                        searchMethodUsed = "Padanan Kluster Chipset/Soket";
                    } else {
                        // Semak padanan model di dalam setiap jenama
                        for (let brand of data.brands) {
                            for (let model of brand.models) {
                                if (model.toUpperCase().includes(query) || query.includes(model.toUpperCase())) {
                                    if (!matchedKeys.includes(key)) {
                                        matchedKeys.push(key);
                                    }
                                    searchMethodUsed = "Padanan Kata Kunci Siri Model Motherboard";
                                }
                            }
                        }
                    }
                }
            }

            // Memproses pengisian data antaramuka
            if (matchedKeys.length > 0) {
                // Bina setiap blok soket yang sepadan secara dinamik ke dalam container utama
                matchedKeys.forEach(key => {
                    const data = socketDatabase[key];
                    
                    // Blok komponen hub soket
                    const socketBlock = document.createElement('div');
                    socketBlock.className = "bg-slate-900/40 p-6 rounded-2xl border border-slate-800/60 shadow-xl space-y-6 relative overflow-hidden";
                    
                    // Tapak penapis jenama dalam blok
                    let brandsHTML = "";
                    let displayedBrandCount = 0;

                    data.brands.forEach(brand => {
                        // Jika carian adalah jenama khusus, tapis keluar jenama lain
                        if (filterSpecificBrand && brand.name.toUpperCase() !== filterSpecificBrand) {
                            return;
                        }
                        
                        displayedBrandCount++;
                        let modelsHTML = "";
                        
                        brand.models.forEach(model => {
                            // Berikan efek highlight bersinar jika sepadan dengan input carian model
                            const isKeywordMatch = query && (model.toUpperCase().includes(query) || query.includes(model.toUpperCase()));
                            const highlightClass = isKeywordMatch 
                                ? "bg-amber-500/20 border-amber-500 text-amber-300 font-extrabold shadow-md shadow-amber-500/10 scale-105" 
                                : "bg-slate-950 border-slate-800 text-slate-300 hover:border-slate-700";

                            modelsHTML += `<span class="inline-block border text-xs px-3 py-1.5 rounded-lg font-mono tracking-tight transition-all ${highlightClass}">${model}</span>`;
                        });

                        brandsHTML += `
                            <div class="bg-slate-950/40 p-4 rounded-xl border border-slate-800/50 flex flex-col justify-between group">
                                <div class="flex items-center justify-between border-b border-slate-800/50 pb-2 mb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="w-1.5 h-3 bg-cyan-500 rounded-full group-hover:bg-emerald-500 transition-colors"></span>
                                        <h5 class="text-sm font-extrabold text-white tracking-wide group-hover:text-cyan-400 transition-colors">${brand.name}</h5>
                                    </div>
                                    <span class="text-[9px] bg-slate-800/80 border border-slate-700/60 px-2 py-0.5 rounded text-slate-400 font-medium font-mono">${brand.models.length} Model Pilihan</span>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    ${modelsHTML}
                                </div>
                            </div>
                        `;
                    });

                    // Jika tiada jenama sepadan dalam kombinasi tapak penapis (safety check)
                    if (displayedBrandCount === 0) return;

                    socketBlock.innerHTML = `
                        <!-- Header Soket Hub -->
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800/80 pb-4">
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-[9px] font-black uppercase tracking-wider text-cyan-400 bg-cyan-400/10 px-2 py-0.5 rounded border border-cyan-500/20">Soket Platform</span>
                                    <span class="text-[9px] font-bold px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-400">${data.era}</span>
                                </div>
                                <h3 class="text-xl font-black text-white mt-1">${data.name}</h3>
                                <p class="text-slate-400 text-xs mt-1 max-w-2xl">${data.desc}</p>
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-[11px] bg-slate-950/60 p-3 rounded-xl border border-slate-800/40 min-w-[200px]">
                                <div>
                                    <span class="text-slate-500 block text-[9px] font-bold uppercase tracking-wider">Chipset</span>
                                    <span class="font-bold text-slate-200 font-mono">${data.chipsets}</span>
                                </div>
                                <div>
                                    <span class="text-slate-500 block text-[9px] font-bold uppercase tracking-wider">RAM</span>
                                    <span class="font-bold text-slate-200 font-mono">${data.ram}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Panel Keserasian CPU -->
                        <div class="bg-slate-950/30 border border-slate-900 p-4 rounded-xl space-y-1">
                            <span class="text-[10px] font-bold tracking-wider text-emerald-400 flex items-center gap-1.5 uppercase">
                                <span>📋</span> Senarai Siri Processor yang Disokong (Support):
                            </span>
                            <p class="text-slate-300 text-xs font-mono bg-slate-950/40 p-2.5 rounded border border-slate-900">${data.cpuSupport}</p>
                        </div>

                        <!-- Senarai Kad Jenama & Rangkaian Model Pilihan -->
                        <div class="space-y-3">
                            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Rangkaian Model Pilihan Pasaran Berdasarkan Carian:</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                ${brandsHTML}
                            </div>
                        </div>
                    `;

                    dynamicResultsContainer.appendChild(socketBlock);
                });

                // Paparkan seksyen keputusan, sembunyikan kotak sedia asal
                resultsSection.classList.remove('hidden');
                emptyState.classList.add('hidden');
            } else {
                showNotification(`Tiada rekod padanan ditemui bagi kata kunci "${queryRaw}". Anda boleh cari kod soket (cth: 1150), nama brand (cth: MSI), atau siri (cth: ROG).`);
                resultsSection.classList.add('hidden');
                emptyState.classList.remove('hidden');
            }
        }

        // Fungsi Memaparkan Kotak Amaran Notifikasi
        function showNotification(msg) {
            const notificationBox = document.getElementById('notificationBox');
            const notificationMessage = document.getElementById('notificationMessage');
            notificationMessage.innerText = msg;
            notificationBox.classList.remove('hidden');
        }
    </script>
</body>
</html>


